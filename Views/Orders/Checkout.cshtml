@* ============================================================
   FILE: Views/Orders/Checkout.cshtml
   PURPOSE: Checkout page — shows book info, quantity picker,
            total price, and Place Order button.
   ============================================================ *@

@model OnlineBookStore.Models.Book
@{
    ViewData["Title"] = "Checkout";
    string CoverClass(int id) => $"book-cover-{(id % 8) + 1}";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <h2 class="fw-bold mb-1">
                <i class="bi bi-bag-check me-2 text-primary"></i>Checkout
            </h2>
            <p class="text-muted mb-4">Review your order and confirm your purchase.</p>

            <div class="card border-0 shadow mb-4" style="border-radius:20px;overflow:hidden">

                @* Book header with gradient cover *@
                <div class="checkout-book-cover @CoverClass(Model.Id)">📖</div>

                <div class="card-body p-4">

                    @* Category badge *@
                    @if (!string.IsNullOrEmpty(ViewBag.CategoryName as string))
                    {
                        <span class="category-badge mb-3 d-inline-block">@ViewBag.CategoryName</span>
                    }

                    <h4 class="fw-bold mb-1">@Model.Title</h4>
                    <p class="text-muted mb-3">by <strong>@Model.Author</strong></p>

                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <div class="p-3" style="background:#f8fafc;border-radius:12px;text-align:center">
                                <div class="text-muted small fw-semibold mb-1">Unit Price</div>
                                <div class="fw-bold fs-4 text-primary">$@Model.Price.ToString("0.00")</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3" style="background:#f8fafc;border-radius:12px;text-align:center">
                                <div class="text-muted small fw-semibold mb-1">In Stock</div>
                                <div class="fw-bold fs-4 text-success">@Model.Stock</div>
                            </div>
                        </div>
                    </div>

                    @* Quantity + submit *@
                    <form method="post" asp-action="Checkout">
                        <input type="hidden" name="bookId" value="@Model.Id" />

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Quantity</label>
                            <div class="d-flex align-items-center gap-3">
                                <input type="number" name="quantity" id="qty"
                                       min="1" max="@Model.Stock" value="1"
                                       class="form-control text-center fw-bold fs-5"
                                       style="width:100px;border-radius:12px"
                                       onchange="updateTotal()" />
                                <span class="text-muted">
                                    Total: <strong id="totalPrice" class="text-primary fs-5">
                                        $@Model.Price.ToString("0.00")
                                    </strong>
                                </span>
                            </div>
                        </div>

                        <div class="d-flex gap-3 flex-wrap">
                            <button type="submit" class="btn btn-primary btn-lg px-5">
                                <i class="bi bi-bag-heart me-2"></i>Place Order
                            </button>
                            <a asp-controller="Books" asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-secondary btn-lg">Cancel</a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Update total price display as user changes quantity
    const unitPrice = @Model.Price;
    function updateTotal() {
        const qty = parseInt(document.getElementById('qty').value) || 1;
        const total = (unitPrice * qty).toFixed(2);
        document.getElementById('totalPrice').textContent = '$' + total;
    }
</script>
}
