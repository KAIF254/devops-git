@* ============================================================
   FILE: Views/Orders/MyOrders.cshtml  (Readora themed)
   PURPOSE: Shows the logged-in user's order history.
   ============================================================ *@

@model List<OnlineBookStore.Models.Order>
@{
    ViewData["Title"] = "My Orders";
    var allItems = ViewBag.AllItems as List<OnlineBookStore.Models.OrderItem> ?? new();
    var allBooks = ViewBag.AllBooks as List<OnlineBookStore.Models.Book>      ?? new();
}

<div class="container py-5">
    <div class="d-flex align-items-end justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <div class="section-eyebrow">Account</div>
            <div class="section-divider"></div>
            <h1 class="section-title mb-0">My Orders</h1>
            <p class="section-subtitle mb-0">@Model.Count order(s) placed</p>
        </div>
        <a asp-controller="Books" asp-action="Index" class="btn btn-outline-blue btn-sm">
            <i class="bi bi-book me-1"></i>Browse Books
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="font-size:4rem;opacity:0.15">🛒</div>
            <h4 class="mt-3" style="font-family:'Playfair Display',serif;color:var(--blue)">
                No orders yet
            </h4>
            <p class="text-muted">Find a book you love and place your first order!</p>
            <a asp-controller="Books" asp-action="Index" class="btn btn-primary mt-2">Browse Books</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var order in Model)
            {
                var items    = allItems.Where(i => i.OrderId == order.Id).ToList();
                var badgeCss = order.Status switch {
                    "Shipped"   => "status-shipped",
                    "Delivered" => "status-delivered",
                    "Cancelled" => "status-cancelled",
                    _           => "status-pending"
                };

                <div class="card border-0 shadow-sm" style="border-radius:16px;overflow:hidden;border:1px solid var(--border)!important">
                    <div class="card-header d-flex justify-content-between align-items-center py-3 px-4"
                         style="background:var(--cream-2);border-bottom:1px solid var(--border)">
                        <div>
                            <span class="fw-bold" style="color:var(--blue)">Order #@order.Id</span>
                            <span class="text-muted ms-3" style="font-size:0.83rem">
                                <i class="bi bi-calendar3 me-1"></i>
                                @order.OrderDate.ToString("dd MMM yyyy")
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="fw-bold fs-5" style="color:var(--blue)">
                                $@order.TotalAmount.ToString("0.00")
                            </span>
                            <span class="status-badge @badgeCss">@order.Status</span>
                        </div>
                    </div>
                    <div class="card-body px-4 py-3" style="background:white">
                        @foreach (var item in items)
                        {
                            var book = allBooks.FirstOrDefault(b => b.Id == item.BookId);
                            var isLast = items.Last() == item;
                            <div class="d-flex justify-content-between align-items-center py-2
                                        @(isLast ? "" : "border-bottom")">
                                <div>
                                    <div class="fw-semibold" style="font-size:0.92rem;color:var(--blue)">
                                        📖 @(book?.Title ?? "Deleted Book")
                                    </div>
                                    <div class="text-muted" style="font-size:0.8rem">
                                        Qty: @item.Quantity × $@item.Price.ToString("0.00")
                                    </div>
                                </div>
                                <div class="fw-bold" style="color:var(--gold-dark)">
                                    $@((item.Quantity * item.Price).ToString("0.00"))
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
