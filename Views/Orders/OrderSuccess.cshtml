@* ============================================================
   FILE: Views/Orders/OrderSuccess.cshtml
   PURPOSE: Confirmation page shown after a successful purchase.
   ============================================================ *@

@{
    ViewData["Title"] = "Order Placed!";
    Layout = null; // Full-page success style
    var order      = ViewBag.Order      as OnlineBookStore.Models.Order;
    var orderItems = ViewBag.OrderItems as List<OnlineBookStore.Models.OrderItem> ?? new();
    var books      = ViewBag.Books      as List<OnlineBookStore.Models.Book>      ?? new();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Placed! — BookStore</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="success-wrapper">
    <div class="success-card">

        @* Animated check icon *@
        <div style="font-size:4rem;line-height:1;animation:fadeIn 0.6s ease">🎉</div>
        <h2 class="fw-bold mt-3 mb-1" style="color:#064e3b">Order Placed!</h2>
        <p class="text-muted mb-0">Thank you for your purchase. Your order has been confirmed.</p>

        @if (order != null)
        {
            <div class="my-4 p-3" style="background:#f0fdf4;border-radius:14px;text-align:left">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Order Number</span>
                    <span class="fw-bold">#@order.Id</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Date</span>
                    <span class="fw-semibold">@order.OrderDate.ToString("dd MMM yyyy, HH:mm")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Total Paid</span>
                    <span class="fw-bold text-success fs-5">$@order.TotalAmount.ToString("0.00")</span>
                </div>
            </div>

            @* Order items summary *@
            <div style="text-align:left" class="mb-4">
                <h6 class="text-muted text-uppercase fw-bold mb-2" style="font-size:0.72rem;letter-spacing:1px">
                    Items Ordered
                </h6>
                @foreach (var item in orderItems)
                {
                    var book = books.FirstOrDefault(b => b.Id == item.BookId);
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <div>
                            <div class="fw-semibold" style="font-size:0.92rem">
                                @(book?.Title ?? "Book")
                            </div>
                            <div class="text-muted small">Qty: @item.Quantity × $@item.Price.ToString("0.00")</div>
                        </div>
                        <div class="fw-bold text-primary">
                            $@((item.Quantity * item.Price).ToString("0.00"))
                        </div>
                    </div>
                }
            </div>
        }

        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a asp-controller="Orders" asp-action="MyOrders"
               class="btn btn-success">
                <i class="bi bi-bag me-1"></i>My Orders
            </a>
            <a asp-controller="Home" asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-house me-1"></i>Home
            </a>
            <a asp-controller="Books" asp-action="Index"
               class="btn btn-outline-primary">
                <i class="bi bi-book me-1"></i>Browse More
            </a>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
