@* ============================================================
   FILE: Views/Cart/Index.cshtml
   PURPOSE: Shopping cart page — shows all items, allows
            quantity updates, removal, and checkout.
   ============================================================ *@

@model List<OnlineBookStore.Models.CartItem>
@{
    ViewData["Title"] = "Your Cart";
    var books = ViewBag.Books as List<OnlineBookStore.Models.Book> ?? new();
    string CoverClass(int id) => $"book-cover-{(id % 8) + 1}";
    decimal grandTotal = 0;
    foreach (var item in Model)
    {
        var b = books.FirstOrDefault(x => x.Id == item.BookId);
        if (b != null) grandTotal += b.Price * item.Quantity;
    }
}

<div class="container py-5 fade-in">

    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <div class="section-divider"></div>
            <h1 class="section-title mb-0">
                <i class="bi bi-bag me-2"></i>Your Cart
            </h1>
            <p class="section-subtitle mb-0">
                @Model.Count item(s) in your cart
            </p>
        </div>
        <a asp-controller="Books" asp-action="Index" class="btn btn-outline-blue btn-sm">
            <i class="bi bi-book me-1"></i>Continue Shopping
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="font-size:5rem;opacity:0.2">🛒</div>
            <h4 class="mt-3" style="color:var(--blue); font-family:'Playfair Display',serif">
                Your cart is empty
            </h4>
            <p class="text-muted">Browse our collection and add some books!</p>
            <a asp-controller="Books" asp-action="Index"
               class="btn btn-primary mt-2">
                Browse Books
            </a>
        </div>
    }
    else
    {
        <div class="row align-items-start gy-4">

            @* ── Cart Items List ───────────────────────────────── *@
            <div class="col-lg-8">
                @foreach (var item in Model)
                {
                    var book = books.FirstOrDefault(b => b.Id == item.BookId);
                    if (book == null) continue;
                    var lineTotal = book.Price * item.Quantity;

                    <div class="cart-item-row d-flex align-items-center gap-4 flex-wrap">
                        @* Book icon cover *@
                        <div class="book-cover @CoverClass(book.Id)"
                             style="width:70px;height:90px;border-radius:10px;font-size:2rem;flex-shrink:0">
                            📖
                        </div>

                        @* Book info *@
                        <div class="flex-fill">
                            <h5 class="book-title mb-1" style="font-size:1rem">
                                <a asp-controller="Books" asp-action="Details"
                                   asp-route-id="@book.Id"
                                   class="text-decoration-none" style="color:var(--blue)">
                                    @book.Title
                                </a>
                            </h5>
                            <p class="text-muted mb-2" style="font-size:0.85rem">
                                <i class="bi bi-person me-1"></i>@book.Author
                            </p>
                            <div class="fw-bold" style="color:var(--gold-dark);font-size:1.1rem">
                                $@book.Price.ToString("0.00") each
                            </div>
                        </div>

                        @* Quantity updater *@
                        <form method="post" asp-controller="Cart" asp-action="UpdateQuantity"
                              class="d-flex align-items-center gap-2">
                            <input type="hidden" name="bookId" value="@book.Id" />
                            <label style="font-size:0.82rem;font-weight:600;color:var(--text-muted)">Qty:</label>
                            <input type="number" name="quantity"
                                   value="@item.Quantity" min="1" max="@book.Stock"
                                   class="form-control text-center fw-bold"
                                   style="width:70px;border-radius:8px;padding:6px"
                                   onchange="this.form.submit()" />
                        </form>

                        @* Line total *@
                        <div class="text-end" style="min-width:80px">
                            <div class="fw-bold fs-5" style="color:var(--blue)">
                                $@lineTotal.ToString("0.00")
                            </div>
                        </div>

                        @* Remove button *@
                        <form method="post" asp-controller="Cart" asp-action="RemoveFromCart">
                            <input type="hidden" name="bookId" value="@book.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                    title="Remove from cart"
                                    onclick="return confirm('Remove @book.Title from cart?')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>

            @* ── Order Summary Box ─────────────────────────────── *@
            <div class="col-lg-4">
                <div class="order-summary-box" style="position:sticky;top:80px">
                    <h5 class="section-title mb-3" style="font-size:1.15rem">
                        Order Summary
                    </h5>

                    @foreach (var item in Model)
                    {
                        var book = books.FirstOrDefault(b => b.Id == item.BookId);
                        if (book == null) continue;
                        <div class="d-flex justify-content-between mb-2" style="font-size:0.88rem">
                            <span class="text-muted">
                                @book.Title <span class="badge bg-secondary ms-1">×@item.Quantity</span>
                            </span>
                            <span class="fw-semibold">$@((book.Price * item.Quantity).ToString("0.00"))</span>
                        </div>
                    }

                    <hr style="border-color:var(--cream-3)" />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold" style="font-size:1rem">Total</span>
                        <span class="fw-bold fs-3" style="color:var(--blue)">
                            $@grandTotal.ToString("0.00")
                        </span>
                    </div>

                    <a asp-controller="Cart" asp-action="Checkout"
                       class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-bag-check me-2"></i>Proceed to Checkout
                    </a>

                    <div class="text-center mt-3" style="font-size:0.82rem;color:var(--text-muted)">
                        <i class="bi bi-shield-check me-1 text-success"></i>
                        Secure checkout
                    </div>
                </div>
            </div>

        </div>
    }
</div>
