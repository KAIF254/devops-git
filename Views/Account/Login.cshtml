

@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Login — Readora</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="auth-wrapper">
    <div class="auth-card">

        @* Logo *@
        <div class="auth-logo">📚&nbsp;<span style="color:#1e3a5f">Read<span class="gold">ora</span></span></div>
        <p class="auth-subtitle">"Where Stories Begin."</p>

        @* Error message *@
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger d-flex gap-2 align-items-center mb-3">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success d-flex gap-2 align-items-center mb-3">
                <i class="bi bi-check-circle-fill"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        @* Login form *@
        <form method="post" asp-action="Login">
            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text"
                          style="background:var(--cream-2);border-radius:8px 0 0 8px">
                        <i class="bi bi-envelope" style="color:var(--text-muted)"></i>
                    </span>
                    <input type="email" name="email" class="form-control" required
                           placeholder="your@email.com"
                           style="border-left:none;border-radius:0 8px 8px 0" />
                </div>
            </div>
            <div class="mb-4">
                <label class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text"
                          style="background:var(--cream-2);border-radius:8px 0 0 8px">
                        <i class="bi bi-lock" style="color:var(--text-muted)"></i>
                    </span>
                    <input type="password" name="password" class="form-control" required
                           placeholder="••••••••"
                           style="border-left:none;border-radius:0 8px 8px 0" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-lg">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </button>
        </form>

        <div class="auth-divider">or</div>
        <p class="text-center mb-0" style="font-size:0.92rem;color:var(--text-muted)">
            New to Readora?
            <a asp-controller="Account" asp-action="Register"
               class="fw-semibold text-decoration-none" style="color:var(--blue)">
                Create an account
            </a>
        </p>
        <div class="text-center mt-3">
            <a asp-controller="Home" asp-action="Index"
               style="color:var(--text-muted);font-size:0.82rem;text-decoration:none">
                <i class="bi bi-arrow-left me-1"></i>Back to Home
            </a>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
