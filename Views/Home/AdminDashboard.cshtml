@* ============================================================
   FILE: Views/Home/AdminDashboard.cshtml
   PURPOSE: Admin Dashboard — stats overview + quick management.
   Uses _AdminLayout (dark sidebar) instead of the user _Layout.
   ============================================================ *@

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    var recentOrders = ViewBag.RecentOrders as List<OnlineBookStore.Models.Order>    ?? new();
    var users        = ViewBag.Users        as List<OnlineBookStore.Models.User>     ?? new();
    var allBooks     = ViewBag.AllBooks     as List<OnlineBookStore.Models.Book>     ?? new();
    var categories   = ViewBag.Categories   as List<OnlineBookStore.Models.Category> ?? new();
}

@* ── STAT CARDS ─────────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-blue">
            <div class="stat-icon-wrap" style="background:rgba(255,255,255,0.18)">📚</div>
            <div class="stat-info">
                <div class="stat-value">@ViewBag.TotalBooks</div>
                <div class="stat-label">Total Books</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-green">
            <div class="stat-icon-wrap" style="background:rgba(255,255,255,0.18)">👥</div>
            <div class="stat-info">
                <div class="stat-value">@ViewBag.TotalUsers</div>
                <div class="stat-label">Registered Users</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-gold">
            <div class="stat-icon-wrap" style="background:rgba(255,255,255,0.18)">🛒</div>
            <div class="stat-info">
                <div class="stat-value">@ViewBag.TotalOrders</div>
                <div class="stat-label">Total Orders</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-red">
            <div class="stat-icon-wrap" style="background:rgba(255,255,255,0.18)">💰</div>
            <div class="stat-info">
                <div class="stat-value">$@(((decimal)ViewBag.TotalRevenue).ToString("N0"))</div>
                <div class="stat-label">Total Revenue</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">

    @* ── Books Table ──────────────────────────────────────────── *@
    <div class="col-lg-7">
        <div class="admin-table-card mb-4">
            <div class="admin-table-header">
                <h6><i class="bi bi-book me-2"></i>Books</h6>
                <a asp-controller="Books" asp-action="Create" class="btn btn-admin-gold btn-sm">
                    <i class="bi bi-plus me-1"></i>Add Book
                </a>
            </div>
            <div class="table-responsive">
                <table class="table admin-table mb-0">
                    <thead><tr>
                        <th>#</th><th>Title</th><th>Author</th>
                        <th>Price</th><th>Stock</th><th>Actions</th>
                    </tr></thead>
                    <tbody>
                        @if (!allBooks.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-3">No books</td></tr>
                        }
                        @foreach (var book in allBooks.Take(8))
                        {
                            <tr>
                                <td class="text-muted" style="font-size:0.78rem">@book.Id</td>
                                <td class="fw-semibold" style="max-width:160px">
                                    <span class="d-block text-truncate" style="max-width:150px">
                                        @book.Title
                                    </span>
                                </td>
                                <td class="text-muted">@book.Author</td>
                                <td class="fw-bold" style="color:#c9a84c">$@book.Price.ToString("0.00")</td>
                                <td>
                                    @if (book.Stock > 0)
                                    {
                                        <span class="badge bg-success">@book.Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Out</span>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Books" asp-action="Edit"
                                       asp-route-id="@book.Id"
                                       class="btn btn-warning btn-sm me-1"
                                       style="font-size:0.75rem;padding:3px 8px">Edit</a>
                                    <a asp-controller="Books" asp-action="Delete"
                                       asp-route-id="@book.Id"
                                       class="btn btn-danger btn-sm"
                                       style="font-size:0.75rem;padding:3px 8px">Del</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Recent Orders Table *@
        <div class="admin-table-card">
            <div class="admin-table-header">
                <h6><i class="bi bi-receipt me-2"></i>Recent Orders</h6>
                <a asp-controller="Admin" asp-action="ManageOrders"
                   class="btn btn-admin-primary btn-sm">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table admin-table mb-0">
                    <thead><tr>
                        <th>Order #</th><th>User</th><th>Date</th><th>Total</th><th>Status</th>
                    </tr></thead>
                    <tbody>
                        @if (!recentOrders.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">No orders</td></tr>
                        }
                        @foreach (var ord in recentOrders)
                        {
                            var user = users.FirstOrDefault(u => u.Id == ord.UserId);
                            var badgeCss = ord.Status switch {
                                "Shipped" => "status-shipped", "Delivered" => "status-delivered",
                                "Cancelled" => "status-cancelled", _ => "status-pending"
                            };
                            <tr>
                                <td class="fw-bold">#@ord.Id</td>
                                <td style="font-size:0.85rem">@(user?.Name ?? "User #" + ord.UserId)</td>
                                <td style="font-size:0.82rem">@ord.OrderDate.ToString("dd MMM yyyy")</td>
                                <td class="fw-bold text-success">$@ord.TotalAmount.ToString("0.00")</td>
                                <td>
                                    <span class="status-badge @badgeCss">@ord.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ── Right Column ─────────────────────────────────────────── *@
    <div class="col-lg-5">

        @* Users *@
        <div class="admin-table-card mb-4">
            <div class="admin-table-header">
                <h6><i class="bi bi-people me-2"></i>Users (@users.Count)</h6>
                <a asp-controller="Admin" asp-action="ManageUsers"
                   class="btn btn-admin-primary btn-sm">Manage</a>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var user in users.Take(5))
                {
                    <li class="list-group-item d-flex align-items-center gap-3 py-2 px-3">
                        <div class="rounded-circle fw-bold text-white d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:32px;height:32px;font-size:0.82rem;
                                    background:@(user.Role == "Admin" ? "#c9a84c" : "#1a3c5f")">
                            @user.Name.Substring(0,1).ToUpper()
                        </div>
                        <div>
                            <div class="fw-semibold" style="font-size:0.87rem">@user.Name</div>
                            <div class="text-muted" style="font-size:0.75rem">@user.Email</div>
                        </div>
                        @if (user.Role == "Admin")
                        {
                            <span class="badge ms-auto"
                                  style="background:#c9a84c;color:#000;font-size:0.6rem">ADMIN</span>
                        }
                    </li>
                }
            </ul>
        </div>

        @* Categories *@
        <div class="admin-table-card">
            <div class="admin-table-header">
                <h6><i class="bi bi-grid me-2"></i>Categories</h6>
                <a asp-controller="Categories" asp-action="Create"
                   class="btn btn-admin-gold btn-sm">+ Add</a>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var cat in categories)
                {
                    var cnt = allBooks.Count(b => b.CategoryId == cat.Id);
                    <li class="list-group-item d-flex align-items-center justify-content-between py-2 px-3">
                        <span class="fw-semibold" style="font-size:0.88rem">@cat.Name</span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge rounded-pill" style="background:#1a3c5f">@cnt</span>
                            <a asp-controller="Categories" asp-action="Edit"
                               asp-route-id="@cat.Id"
                               class="btn btn-warning btn-sm"
                               style="font-size:0.72rem;padding:2px 8px">Edit</a>
                        </div>
                    </li>
                }
            </ul>
        </div>

    </div>
</div>
