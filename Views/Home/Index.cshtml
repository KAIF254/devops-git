@* ============================================================
   FILE: Views/Home/Index.cshtml  (Readora — v3)
   PURPOSE: Modern homepage with:
     1. Bootstrap 5 Carousel (3 slides with animated text)
     2. Browse by Category (AOS: fade-up)
     3. Top-Ranked Books scroll (AOS: fade-left)
     4. Featured Books grid (AOS: zoom-in)
     5. Trending Books horizontal slider (AOS: fade-right)
     6. Newsletter section
   ============================================================ *@

@model List<OnlineBookStore.Models.Book>
@{
    ViewData["Title"] = "Home";
    var categories = ViewBag.Categories as List<OnlineBookStore.Models.Category> ?? new();
    var topRanked  = ViewBag.TopRanked  as List<OnlineBookStore.Models.Book>     ?? new();
    bool isLoggedIn = Context.Session.GetInt32("UserId") != null;
    string CoverClass(int id) => $"book-cover-{(id % 8) + 1}";
    string[] catIcons = { "📖","🔬","🌍","💡","💻","👤","🧒","🎨" };
}

@* ── 1. BOOTSTRAP HERO CAROUSEL ────────────────────────────── *@
<section class="hero-carousel-wrapper">
    <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel"
         data-bs-interval="4000">

        <div class="carousel-inner">

            @* SLIDE 1 *@
            <div class="carousel-item active">
                <div class="hero-slide hero-slide-1">
                    @* Floating particle animations *@
                    <span class="hero-particle">📖</span>
                    <span class="hero-particle">⭐</span>
                    <span class="hero-particle">📚</span>
                    <span class="hero-particle">✨</span>
                    <span class="hero-particle">🔖</span>
                    <span class="hero-particle">💫</span>
                    <div class="container hero-slide-content">
                        <div class="hero-eyebrow">📚&nbsp;Readora Bookstore</div>
                        <h1 class="hero-slide-title">
                            Discover Your Next<br/>
                            <span>Favourite Book</span>
                        </h1>
                        <p class="hero-slide-sub">
                            Browse thousands of titles — fiction, science, history, programming and more.
                        </p>
                        <div class="d-flex gap-3 flex-wrap mt-4">
                            <a asp-controller="Books" asp-action="Index"
                               class="btn-hero-primary">
                                <i class="bi bi-search"></i>Browse Books
                            </a>
                            <a asp-controller="Categories" asp-action="Index"
                               class="btn-hero-outline">
                                <i class="bi bi-grid"></i>View Categories
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            @* SLIDE 2 *@
            <div class="carousel-item">
                <div class="hero-slide hero-slide-2">
                    <span class="hero-particle">📜</span>
                    <span class="hero-particle">🌍</span>
                    <span class="hero-particle">📖</span>
                    <span class="hero-particle">✨</span>
                    <span class="hero-particle">🖊️</span>
                    <span class="hero-particle">📝</span>
                    <div class="container hero-slide-content">
                        <div class="hero-eyebrow">🌍&nbsp;Endless Stories</div>
                        <h1 class="hero-slide-title">
                            Explore Thousands<br/>
                            <span>of Stories</span>
                        </h1>
                        <p class="hero-slide-sub">
                            Every book is a new world. Find yours today.
                        </p>
                        <div class="d-flex gap-3 flex-wrap mt-4">
                            <a asp-controller="Categories" asp-action="Index"
                               class="btn-hero-primary">
                                <i class="bi bi-grid"></i>View Categories
                            </a>
                            <a asp-controller="Books" asp-action="Index"
                               class="btn-hero-outline">
                                <i class="bi bi-book"></i>All Books
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            @* SLIDE 3 *@
            <div class="carousel-item">
                <div class="hero-slide hero-slide-3">
                    <span class="hero-particle">⭐</span>
                    <span class="hero-particle">🏆</span>
                    <span class="hero-particle">📚</span>
                    <span class="hero-particle">💡</span>
                    <span class="hero-particle">🔖</span>
                    <span class="hero-particle">✨</span>
                    <div class="container hero-slide-content">
                        <div class="hero-eyebrow">⭐&nbsp;Top Picks</div>
                        <h1 class="hero-slide-title">
                            Top Picks From<br/>
                            <span>Our Readers</span>
                        </h1>
                        <p class="hero-slide-sub">
                            Hand-curated selections loved by thousands of readers.
                        </p>
                        <div class="d-flex gap-3 flex-wrap mt-4">
                            <a asp-controller="Books" asp-action="Index"
                               class="btn-hero-primary">
                                <i class="bi bi-star"></i>See Top Books
                            </a>
                            <a asp-controller="Account" asp-action="Register"
                               class="btn-hero-outline">
                                <i class="bi bi-person-plus"></i>Join Free
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Controls *@
        <button class="carousel-control-prev" type="button"
                data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button"
                data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>

        @* Indicators *@
        <div class="carousel-indicators" style="bottom:20px">
            <button type="button" data-bs-target="#heroCarousel"
                    data-bs-slide-to="0" class="active"></button>
            <button type="button" data-bs-target="#heroCarousel"
                    data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#heroCarousel"
                    data-bs-slide-to="2"></button>
        </div>
    </div>
</section>

@* ── 2. BROWSE BY CATEGORY ──────────────────────────────────── *@
@if (categories.Any())
{
    <section class="container mt-5">
        <div class="section-header" data-aos="fade-up">
            <div class="section-eyebrow">Explore</div>
            <div class="section-divider"></div>
            <h2 class="section-title">Browse by Category</h2>
            <p class="section-subtitle">Find books in your favourite genre</p>
        </div>
        <div class="row g-3 mt-3">
            @for (int i = 0; i < Math.Min(categories.Count, 8); i++)
            {
                var cat = categories[i];
                var cnt = Model.Count(b => b.CategoryId == cat.Id);
                var ico = catIcons[i % catIcons.Length];
                <div class="col-6 col-sm-4 col-md-3 col-lg-auto" style="min-width:135px;flex:1"
                     data-aos="fade-up" data-aos-delay="@(i * 60)">
                    <a asp-controller="Categories" asp-action="Books"
                       asp-route-id="@cat.Id" class="cat-card h-100">
                        <div class="cat-icon">@ico</div>
                        <div class="cat-name">@cat.Name</div>
                        <div class="cat-count">@cnt books</div>
                    </a>
                </div>
            }
        </div>
    </section>
}

@* ── 3. TOP-RANKED BOOKS (horizontal scroll) ────────────────── *@
@if (topRanked.Any())
{
    <section class="container mt-5">
        <div class="d-flex align-items-end justify-content-between mb-3" data-aos="fade-up">
            <div>
                <div class="section-eyebrow" style="color:#a8882c">⭐ Best Sellers</div>
                <div class="section-divider"></div>
                <h2 class="section-title">Top-Ranked Books</h2>
            </div>
            <a asp-controller="Books" asp-action="Index"
               class="btn btn-outline-blue btn-sm">
                See All <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="top-ranked-scroller" data-aos="fade-left">
            @for (int r = 0; r < topRanked.Count; r++)
            {
                var book = topRanked[r];
                <a asp-controller="Books" asp-action="Details"
                   asp-route-id="@book.Id"
                   class="top-ranked-card position-relative">
                    @* Use real image if available, else gradient cover *@
                    @if (!string.IsNullOrEmpty(book.ImageUrl))
                    {
                        <img src="@book.ImageUrl" alt="@book.Title"
                             style="width:100%;height:120px;object-fit:cover" />
                    }
                    else
                    {
                        <div class="top-ranked-cover @CoverClass(book.Id)">📖</div>
                    }
                    <span class="rank-badge">#@(r + 1)</span>
                    <div class="top-ranked-info">
                        <div class="top-ranked-title">@book.Title</div>
                        <div class="top-ranked-price">$@book.Price.ToString("0.00")</div>
                    </div>
                </a>
            }
        </div>
    </section>
}

@* ── 4. FEATURED BOOKS GRID ─────────────────────────────────── *@
<section class="container mt-5">
    <div class="d-flex align-items-end justify-content-between mb-3" data-aos="fade-up">
        <div>
            <div class="section-eyebrow">Hand-Picked</div>
            <div class="section-divider"></div>
            <h2 class="section-title">Featured Books</h2>
            <p class="section-subtitle">Fresh arrivals and editor's picks</p>
        </div>
        <a asp-controller="Books" asp-action="Index"
           class="btn btn-outline-blue btn-sm d-none d-sm-block">
            View All <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="font-size:4rem;opacity:0.12">📚</div>
            <h5 class="mt-3 section-title">No books yet</h5>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var book in Model.Take(8))
            {
                var catName = categories.FirstOrDefault(c => c.Id == book.CategoryId)?.Name ?? "";
                <div class="col-sm-6 col-md-4 col-lg-3"
                     data-aos="zoom-in" data-aos-delay="@(Model.IndexOf(book) * 50)">
                    <div class="book-card">
                        @* Book cover — real image takes priority *@
                        @if (!string.IsNullOrEmpty(book.ImageUrl))
                        {
                            <img src="@book.ImageUrl" alt="@book.Title" class="book-cover-img" />
                        }
                        else
                        {
                            <div class="book-cover @CoverClass(book.Id)">📖</div>
                        }
                        <div class="book-card-body">
                            @if (!string.IsNullOrEmpty(catName))
                            {
                                <span class="category-chip mb-1">@catName</span>
                            }
                            <div class="book-title mt-1">@book.Title</div>
                            <div class="book-author">
                                <i class="bi bi-person me-1"></i>@book.Author
                            </div>
                            <div class="book-price">$@book.Price.ToString("0.00")</div>
                        </div>
                        <div class="book-card-footer d-flex gap-2">
                            <a asp-controller="Books" asp-action="Details"
                               asp-route-id="@book.Id"
                               class="btn btn-outline-blue btn-sm flex-fill">
                                <i class="bi bi-eye me-1"></i>Details
                            </a>
                            @if (isLoggedIn && book.Stock > 0)
                            {
                                <form method="post" asp-controller="Cart" asp-action="AddToCart"
                                      style="display:contents">
                                    <input type="hidden" name="bookId" value="@book.Id" />
                                    <button type="submit" class="btn btn-gold btn-sm"
                                            title="Add to Cart">
                                        <i class="bi bi-bag-plus"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

@* ── 5. TRENDING BOOKS SLIDER ───────────────────────────────── *@
@if (Model.Count > 4)
{
    <section class="container mt-5" data-aos="fade-right">
        <div class="d-flex align-items-end justify-content-between mb-3">
            <div>
                <div class="section-eyebrow" style="color:#8b5e3c">🔥 Trending</div>
                <div class="section-divider"></div>
                <h2 class="section-title">Trending Now</h2>
            </div>
        </div>
        <div class="top-ranked-scroller">
            @foreach (var book in Model.Skip(4).Take(8))
            {
                <a asp-controller="Books" asp-action="Details"
                   asp-route-id="@book.Id"
                   class="top-ranked-card">
                    @if (!string.IsNullOrEmpty(book.ImageUrl))
                    {
                        <img src="@book.ImageUrl" alt="@book.Title"
                             style="width:100%;height:120px;object-fit:cover" />
                    }
                    else
                    {
                        <div class="top-ranked-cover @CoverClass(book.Id)">📖</div>
                    }
                    <div class="top-ranked-info">
                        <div class="top-ranked-title">@book.Title</div>
                        <div class="top-ranked-price">$@book.Price.ToString("0.00")</div>
                    </div>
                </a>
            }
        </div>
    </section>
}

@* ── 6. NEWSLETTER SECTION ──────────────────────────────────── *@
<section class="newsletter-section mt-5" data-aos="fade-up">
    <div class="container">
        <div class="newsletter-card">
            <div class="row align-items-center gy-3">
                <div class="col-md-6">
                    <div style="font-size:2rem;margin-bottom:8px">📬</div>
                    <h3 style="font-family:'Playfair Display',serif;font-size:1.6rem;
                               font-weight:700;color:white;margin-bottom:6px">
                        Stay in the Loop
                    </h3>
                    <p style="color:rgba(255,255,255,0.7);font-size:0.93rem;margin:0">
                        Get notified about new arrivals, exclusive deals, and
                        reading recommendations every week.
                    </p>
                </div>
                <div class="col-md-6">
                    <div class="input-group" style="border-radius:12px;overflow:hidden">
                        <input type="email" class="form-control"
                               placeholder="Enter your email address…"
                               style="padding:14px 18px;font-size:0.95rem;border:none;
                                      border-radius:0" />
                        <button class="btn btn-gold px-4 fw-bold" type="button"
                                onclick="alert('Thank you for subscribing!')">
                            Subscribe
                        </button>
                    </div>
                    <p style="color:rgba(255,255,255,0.45);font-size:0.78rem;margin-top:8px">
                        <i class="bi bi-shield-check me-1"></i>
                        No spam. Unsubscribe anytime.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
<div style="margin-bottom:60px"></div>
