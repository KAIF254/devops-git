

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Readora Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>

@* ── SIDEBAR ─────────────────────────────────────────────── *@
<nav class="admin-sidebar" id="adminSidebar">

    @* Logo *@
    <div class="sidebar-logo">
        <div class="logo-text">📚 Read<span>ora</span></div>
        <div class="logo-tagline">"Where Stories Begin."</div>
        <span class="admin-badge">Admin Panel</span>
    </div>

    @* Navigation *@
    <div class="sidebar-nav">

        <div class="sidebar-section-label">OVERVIEW</div>
        <a asp-controller="Home" asp-action="AdminDashboard"
           class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AdminDashboard" ? "active" : "")">
            <i class="bi bi-speedometer2"></i>Dashboard
        </a>

        <div class="sidebar-section-label mt-2">MANAGE</div>

        @* ── Points to Admin/ManageBooks (admin table) ─── *@
        <a asp-controller="Admin" asp-action="ManageBooks"
           class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ManageBooks" ? "active" : "")">
            <i class="bi bi-book"></i>Manage Books
        </a>

        @* ── Points to Admin/ManageCategories (admin table) *@
        <a asp-controller="Admin" asp-action="ManageCategories"
           class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ManageCategories" ? "active" : "")">
            <i class="bi bi-grid"></i>Manage Categories
        </a>

        <a asp-controller="Admin" asp-action="ManageOrders"
           class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ManageOrders" ? "active" : "")">
            <i class="bi bi-receipt"></i>Manage Orders
        </a>

        <a asp-controller="Admin" asp-action="ManageUsers"
           class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ManageUsers" ? "active" : "")">
            <i class="bi bi-people"></i>Manage Users
        </a>
    </div>

    @* Admin info + Logout *@
    <div class="sidebar-logout">
        <div class="d-flex align-items-center gap-2 px-2 mb-3"
             style="font-size:0.82rem; color:rgba(255,255,255,0.45)">
            <div style="width:30px;height:30px;background:#c9a84c;border-radius:50%;
                        display:flex;align-items:center;justify-content:center;
                        font-weight:800;font-size:0.82rem;color:#000;flex-shrink:0">
                A
            </div>
            <div>
                <div style="color:rgba(255,255,255,0.8);font-weight:600;font-size:0.84rem">
                    @Context.Session.GetString("UserName")
                </div>
                <div style="font-size:0.72rem">Administrator</div>
            </div>
        </div>
        <a asp-controller="Account" asp-action="Logout" class="nav-link">
            <i class="bi bi-box-arrow-right"></i>Logout
        </a>
    </div>
</nav>

@* ── MAIN CONTENT AREA ───────────────────────────────────── *@
<div class="admin-main">

    @* Topbar *@
    <header class="admin-topbar">
        <button class="btn btn-sm me-2 d-lg-none"
                style="background:transparent;border:none"
                onclick="document.getElementById('adminSidebar').classList.toggle('open')">
            <i class="bi bi-list fs-4" style="color:#1a3c5f"></i>
        </button>
        <div class="page-title">@ViewData["Title"]</div>
        <div class="ms-auto d-flex align-items-center gap-2"
             style="font-size:0.82rem;color:#64748b">
            <i class="bi bi-shield-check text-warning"></i>
            <span>Admin Mode</span>
        </div>
    </header>

    @* Flash messages *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="admin-alerts mt-3">
            <div class="alert alert-success alert-dismissible fade show d-flex gap-2 align-items-center">
                <i class="bi bi-check-circle-fill"></i>
                <span>@TempData["SuccessMessage"]</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="admin-alerts mt-3">
            <div class="alert alert-danger alert-dismissible fade show d-flex gap-2 align-items-center">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@TempData["ErrorMessage"]</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    @* Page content *@
    <main class="admin-content-area">
        @RenderBody()
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
