
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Readora</title>
    <meta name="description" content="Readora — Where Stories Begin. Discover and buy books online." />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
   
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@* ── NAVBAR ─────────────────────────────────────────────────── *@
<nav class="navbar navbar-expand-lg" id="mainNavbar">
    <div class="container">

        
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">📚&nbsp;Readora</a>

        
        <button class="navbar-toggler border-0" type="button"
                data-bs-toggle="collapse" data-bs-target="#mainNav">
            <i class="bi bi-list text-white fs-4"></i>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">

            @* Left links *@
            <ul class="navbar-nav me-auto mt-2 mt-lg-0">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house me-1"></i>Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Books" asp-action="Index">
                        <i class="bi bi-book me-1"></i>Books
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Categories" asp-action="Index">
                        <i class="bi bi-grid me-1"></i>Categories
                    </a>
                </li>
                @if (Context.Session.GetInt32("UserId") != null)
                {
                    var cartCount = Context.Session.GetInt32("CartCount") ?? 0;
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cart" asp-action="Index">
                            <span class="cart-badge">
                                <i class="bi bi-bag"></i>
                                @if (cartCount > 0)
                                {
                                    <span class="cart-count-badge">@cartCount</span>
                                }
                            </span>
                            <span class="ms-1">Cart</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Orders" asp-action="MyOrders">
                            <i class="bi bi-receipt me-1"></i>My Orders
                        </a>
                    </li>
                }
            </ul>

            @* Right — user info / auth *@
            <ul class="navbar-nav ms-auto align-items-center gap-2">
                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <li class="nav-item">
                        <span class="nav-link fw-semibold"
                              style="color:#c9a84c !important;cursor:default">
                            <i class="bi bi-person-circle me-1"></i>
                            @Context.Session.GetString("UserName")
                        </span>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-light btn-sm"
                           asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Login
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-gold btn-sm"
                           asp-controller="Account" asp-action="Register">
                            Register
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

@* ── FLASH MESSAGES ─────────────────────────────────────────── *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-success alert-dismissible fade show d-flex gap-2 align-items-center">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-danger alert-dismissible fade show d-flex gap-2 align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    </div>
}

@* ── MAIN CONTENT ────────────────────────────────────────────── *@
@RenderBody()

@* ── FOOTER ──────────────────────────────────────────────────── *@
<footer>
    <div class="container">
        <div class="row gy-4">
            @* Brand column *@
            <div class="col-md-4">
                <div class="footer-brand mb-1">📚 Read<span>ora</span></div>
                <div class="footer-tagline mb-3">"Where Stories Begin."</div>
                <p style="font-size:0.85rem;line-height:1.8;color:rgba(255,255,255,0.55)">
                    Your one-stop destination for books across every genre.
                    Discover, explore, and fall in love with reading.
                </p>
            </div>

            @* Quick Links *@
            <div class="col-md-2">
                <h6 class="text-white fw-semibold mb-3" style="font-size:0.85rem;letter-spacing:1px;text-transform:uppercase">
                    Quick Links
                </h6>
                <div class="d-flex flex-column gap-2" style="font-size:0.85rem">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Books" asp-action="Index">Browse Books</a>
                    <a asp-controller="Categories" asp-action="Index">Categories</a>
                </div>
            </div>

            @* Account Links *@
            <div class="col-md-2">
                <h6 class="text-white fw-semibold mb-3" style="font-size:0.85rem;letter-spacing:1px;text-transform:uppercase">
                    Account
                </h6>
                <div class="d-flex flex-column gap-2" style="font-size:0.85rem">
                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        <a asp-controller="Cart" asp-action="Index">My Cart</a>
                        <a asp-controller="Orders" asp-action="MyOrders">My Orders</a>
                        <a asp-controller="Account" asp-action="Logout">Logout</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login">Login</a>
                        <a asp-controller="Account" asp-action="Register">Register</a>
                    }
                </div>
            </div>

            @* Contact / About *@
            <div class="col-md-4">
                <h6 class="text-white fw-semibold mb-3" style="font-size:0.85rem;letter-spacing:1px;text-transform:uppercase">
                    About Readora
                </h6>
                <p style="font-size:0.83rem;line-height:1.7;color:rgba(255,255,255,0.5)">
                    An ASP.NET Core MVC bookstore project built with Bootstrap 5,
                    Entity Framework Core, and SQL Server.
                </p>
                <div class="d-flex gap-3 mt-2">
                    <i class="bi bi-envelope" style="color:#c9a84c;font-size:1.1rem"></i>
                    <i class="bi bi-telephone" style="color:#c9a84c;font-size:1.1rem"></i>
                    <i class="bi bi-geo-alt" style="color:#c9a84c;font-size:1.1rem"></i>
                </div>
            </div>
        </div>

        <hr class="footer-divider" />
        <p class="text-center mb-0" style="font-size:0.8rem;color:rgba(255,255,255,0.4)">
            © 2025 Readora. All rights reserved. — Where Stories Begin.
        </p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@* AOS Init *@
<script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
<script>
    AOS.init({ duration: 650, once: true, offset: 60 });

    // Navbar shadow on scroll
    window.addEventListener('scroll', function () {
        const nav = document.getElementById('mainNavbar');
        if (nav) nav.style.boxShadow = window.scrollY > 20
            ? '0 4px 24px rgba(13,33,55,0.4)' : '0 2px 16px rgba(13,33,55,0.3)';
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
