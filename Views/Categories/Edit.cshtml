@* ============================================================
   FILE: Views/Categories/Edit.cshtml — Uses _AdminLayout
   ============================================================ *@

@model OnlineBookStore.Models.Category
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Category";
}

<div style="max-width:480px">
    <div class="admin-form-card">
        <div class="admin-form-header"
             style="background:linear-gradient(90deg,#b8932a,#c9a84c);color:white;border-radius:12px 12px 0 0">
            <h5 class="mb-0 fw-bold"><i class="bi bi-pencil me-2"></i>Edit Category</h5>
        </div>
        <div class="admin-form-body">
            <form method="post" asp-action="Edit">
                <input type="hidden" asp-for="Id" />
                <div class="mb-4">
                    <label class="form-label">Category Name *</label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-admin-gold btn-lg px-5">
                        <i class="bi bi-floppy me-2"></i>Update Category
                    </button>
                    <a asp-controller="Home" asp-action="AdminDashboard"
                       class="btn btn-outline-secondary btn-lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
