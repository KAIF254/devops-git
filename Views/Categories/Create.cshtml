@* ============================================================
   FILE: Views/Categories/Create.cshtml — Uses _AdminLayout
   ============================================================ *@

@model OnlineBookStore.Models.Category
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Category";
}

<div style="max-width:480px">
    <div class="admin-form-card">
        <div class="admin-form-header"
             style="background:linear-gradient(90deg,#1a3c5f,#2d6199);color:white;border-radius:12px 12px 0 0">
            <h5 class="mb-0 fw-bold"><i class="bi bi-folder-plus me-2"></i>Add New Category</h5>
        </div>
        <div class="admin-form-body">
            <form method="post" asp-action="Create">
                <div class="mb-4">
                    <label class="form-label">Category Name *</label>
                    <input asp-for="Name" class="form-control"
                           placeholder="e.g. Fiction, Science, Programming…" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-admin-primary btn-lg px-5">
                        <i class="bi bi-floppy me-2"></i>Save Category
                    </button>
                    <a asp-controller="Home" asp-action="AdminDashboard"
                       class="btn btn-outline-secondary btn-lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
