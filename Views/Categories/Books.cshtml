@* ============================================================
   FILE: Views/Categories/Books.cshtml
   PURPOSE: Shows all books belonging to a specific category.
   ============================================================ *@

@model List<OnlineBookStore.Models.Book>
@{
    ViewData["Title"] = ViewBag.CategoryName + " Books";
    string CoverClass(int id) => $"book-cover-{(id % 8) + 1}";
    bool isAdmin = Context.Session.GetString("UserRole") == "Admin";
}

<div class="container py-5">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-controller="Categories" asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Categories
        </a>
        <div>
            <div class="section-line"></div>
            <h1 class="section-title mb-0">@ViewBag.CategoryName</h1>
            <p class="section-subtitle mb-0">@Model.Count book(s) in this category</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="font-size:3.5rem;opacity:0.2">📚</div>
            <h5 class="mt-3 text-muted">No books in this category yet</h5>
            @if (isAdmin)
            {
                <a asp-controller="Books" asp-action="Create"
                   class="btn btn-primary mt-2">Add Book</a>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var book in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="book-card">
                        @* Show real cover image if available, else colourful gradient *@
                        @if (!string.IsNullOrEmpty(book.ImageUrl))
                        {
                            <img src="@book.ImageUrl" alt="@book.Title"
                                 class="book-cover-img" />
                        }
                        else
                        {
                            <div class="book-cover @CoverClass(book.Id)">📖</div>
                        }
                        <div class="book-card-body">
                            <div class="book-title">@book.Title</div>
                            <div class="book-author">
                                <i class="bi bi-person me-1"></i>@book.Author
                            </div>
                            <div class="book-price">$@book.Price.ToString("0.00")</div>
                            @if (book.Stock <= 0)
                            {
                                <span class="badge bg-danger mt-1">Out of Stock</span>
                            }
                        </div>
                        <div class="book-card-footer">
                            <a asp-controller="Books" asp-action="Details"
                               asp-route-id="@book.Id"
                               class="btn btn-outline-primary btn-sm w-100">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
