@* ============================================================
   FILE: Views/Categories/Index.cshtml  (Readora themed)
   PURPOSE: Public categories page with rich colourful cards.
   ============================================================ *@

@model List<OnlineBookStore.Models.Category>
@{
    ViewData["Title"] = "Categories";
    var bookCounts = ViewBag.BookCounts as Dictionary<int, int> ?? new();
    bool isAdmin   = Context.Session.GetString("UserRole") == "Admin";

    // Alternating cream-coloured backgrounds for variety
    string[] cardBgs  = { "#e8f4fd","#f0faf4","#fff8e7","#fdf4e7","#f0ebfe","#ffe8f0","#e8fbfb","#f4f4f4" };
    string[] catIcons = { "📖","🔬","🌍","💡","💻","👤","🧒","🎨" };
    string[] catDescriptions = {
        "Classic and contemporary fiction", "Science & technology insights",
        "World history & civilizations", "Inspiration & personal growth",
        "Programming & software design", "Biographies & memoirs",
        "Children's & young adult", "Arts, design & creativity"
    };
}

<div class="container py-5">

    <div class="d-flex align-items-end justify-content-between mb-5 flex-wrap gap-2">
        <div>
            <div class="section-eyebrow">Browse by Genre</div>
            <div class="section-divider"></div>
            <h1 class="section-title mb-0">All Categories</h1>
            <p class="section-subtitle mb-0">Find books in your favourite genre</p>
        </div>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-folder-plus me-1"></i>Add Category
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="font-size:4rem;opacity:0.15">🗂️</div>
            <h4 class="mt-3" style="font-family:'Playfair Display',serif;color:var(--blue)">No categories yet</h4>
            @if (isAdmin)
            {
                <a asp-action="Create" class="btn btn-primary mt-2">Add First Category</a>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            @for (int i = 0; i < Model.Count; i++)
            {
                var cat  = Model[i];
                var bg   = cardBgs[i % cardBgs.Length];
                var ico  = catIcons[i % catIcons.Length];
                var desc = catDescriptions[i % catDescriptions.Length];
                var cnt  = bookCounts.GetValueOrDefault(cat.Id, 0);

                <div class="col-sm-6 col-md-4 col-lg-3">
                    <a asp-action="Books" asp-route-id="@cat.Id"
                       class="cat-card h-100" style="background:@bg">
                        <div class="cat-icon">@ico</div>
                        <div class="cat-name">@cat.Name</div>
                        <div class="cat-count">@cnt books</div>
                        <div class="mt-2 text-muted text-center" style="font-size:0.78rem;line-height:1.5">
                            @desc
                        </div>
                        <div class="mt-auto pt-3">
                            <span class="badge"
                                  style="background:var(--blue);color:white;font-size:0.72rem">
                                Browse <i class="bi bi-arrow-right ms-1"></i>
                            </span>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
