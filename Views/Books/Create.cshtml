@* ============================================================
   FILE: Views/Books/Create.cshtml — Uses _AdminLayout
   ============================================================ *@

@model OnlineBookStore.Models.Book
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add New Book";
    var categories = ViewBag.Categories as List<OnlineBookStore.Models.Category> ?? new();
}

<div style="max-width:720px">
    <div class="admin-form-card">
        <div class="admin-form-header"
             style="background:linear-gradient(90deg,#1a3c5f,#2d6199);color:white;border-radius:12px 12px 0 0">
            <h5 class="mb-0 fw-bold"><i class="bi bi-book me-2"></i>Add New Book</h5>
        </div>
        <div class="admin-form-body">
            <form method="post" asp-action="Create">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Book Title *</label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. The Great Gatsby" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Author *</label>
                        <input asp-for="Author" class="form-control" placeholder="e.g. F. Scott Fitzgerald" required />
                        <span asp-validation-for="Author" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Category *</label>
                        <select asp-for="CategoryId" class="form-select" required>
                            <option value="">— Select Category —</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4"
                                  placeholder="A brief summary of this book…"></textarea>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Price ($) *</label>
                        <input asp-for="Price" type="number" step="0.01" min="0"
                               class="form-control" placeholder="9.99" required />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Stock Quantity *</label>
                        <input asp-for="Stock" type="number" min="0"
                               class="form-control" placeholder="50" required />
                        <span asp-validation-for="Stock" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Release Date</label>
                        <input asp-for="ReleaseDate" type="date" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Cover Image URL <span class="text-muted">(optional)</span></label>
                        <input asp-for="ImageUrl" type="text" class="form-control"
                               placeholder="https://example.com/cover.jpg" />
                        <div class="form-text">Leave empty for a gradient placeholder cover.</div>
                    </div>
                </div>
                <hr class="my-4" />
                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-admin-primary btn-lg px-5">
                        <i class="bi bi-floppy me-2"></i>Save Book
                    </button>
                    <a asp-controller="Home" asp-action="AdminDashboard"
                       class="btn btn-outline-secondary btn-lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
