@* ============================================================
   FILE: Views/Books/Index.cshtml  (Readora themed)
   PURPOSE: Book catalog with search + category filter.
            Admin users see Edit/Delete buttons on each card.
   ============================================================ *@

@model List<OnlineBookStore.Models.Book>
@{
    ViewData["Title"] = "Books";
    var categories = ViewBag.Categories as List<OnlineBookStore.Models.Category> ?? new();
    bool isAdmin   = Context.Session.GetString("UserRole") == "Admin";
    bool isLoggedIn = Context.Session.GetInt32("UserId") != null;
    string CoverClass(int id) => $"book-cover-{(id % 8) + 1}";
}

<div class="container py-5">

    @* Header *@
    <div class="d-flex align-items-end justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <div class="section-eyebrow">Catalog</div>
            <div class="section-divider"></div>
            <h1 class="section-title mb-0">All Books</h1>
            <p class="section-subtitle mb-0">@Model.Count book(s) available</p>
        </div>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Add Book
            </a>
        }
    </div>

    @* Search + Filter *@
    <form method="get" asp-action="Index" class="mb-5">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Search</label>
                <div class="input-group">
                    <span class="input-group-text" style="background:var(--cream-2);border-radius:8px 0 0 8px">
                        <i class="bi bi-search" style="color:var(--text-muted)"></i>
                    </span>
                    <input type="text" name="searchTitle" class="form-control"
                           placeholder="Search by title or author…"
                           value="@ViewBag.SearchTitle"
                           style="border-left:0;border-radius:0 8px 8px 0" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Category</label>
                <select name="categoryId" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id"
                                selected="@(ViewBag.CategoryId?.ToString() == cat.Id.ToString())">
                            @cat.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x"></i>
                </a>
            </div>
        </div>
    </form>

    @* Grid *@
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="font-size:4rem;opacity:0.15">📚</div>
            <h4 class="mt-3" style="font-family:'Playfair Display',serif;color:var(--blue)">
                No books found
            </h4>
            <p class="text-muted">Try a different search or clear the filters.</p>
            <a asp-action="Index" class="btn btn-outline-blue mt-2">Clear Filters</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var book in Model)
            {
                var catName = categories.FirstOrDefault(c => c.Id == book.CategoryId)?.Name ?? "";
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="book-card">
                        @* Show real cover image if available, else colourful gradient *@
                        @if (!string.IsNullOrEmpty(book.ImageUrl))
                        {
                            <img src="@book.ImageUrl" alt="@book.Title"
                                 class="book-cover-img" />
                        }
                        else
                        {
                            <div class="book-cover @CoverClass(book.Id)">📖</div>
                        }
                        <div class="book-card-body">
                            @if (!string.IsNullOrEmpty(catName))
                            {
                                <span class="category-chip mb-1">@catName</span>
                            }
                            <div class="book-title mt-1">@book.Title</div>
                            <div class="book-author">
                                <i class="bi bi-person me-1"></i>@book.Author
                            </div>
                            <div class="book-price">$@book.Price.ToString("0.00")</div>
                            @if (book.Stock <= 0)
                            {
                                <span class="badge bg-danger mt-1" style="font-size:0.7rem">Out of Stock</span>
                            }
                        </div>
                        <div class="book-card-footer">
                            <a asp-action="Details" asp-route-id="@book.Id"
                               class="btn btn-outline-blue btn-sm w-100 mb-2">
                                <i class="bi bi-eye me-1"></i>View Details
                            </a>
                            @if (!isAdmin && isLoggedIn && book.Stock > 0)
                            {
                                <form method="post" asp-controller="Cart" asp-action="AddToCart">
                                    <input type="hidden" name="bookId" value="@book.Id" />
                                    <button type="submit"
                                            class="btn btn-gold btn-sm w-100">
                                        <i class="bi bi-bag-plus me-1"></i>Add to Cart
                                    </button>
                                </form>
                            }
                            @if (isAdmin)
                            {
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@book.Id"
                                       class="btn btn-warning btn-sm flex-fill">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@book.Id"
                                       class="btn btn-outline-danger btn-sm flex-fill">
                                        <i class="bi bi-trash me-1"></i>Del
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
