@* ============================================================
   FILE: Views/Books/Delete.cshtml — Uses _AdminLayout
   ============================================================ *@

@model OnlineBookStore.Models.Book
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete Book";
    string CoverClass(int id) => $"book-cover-{(id % 8) + 1}";
}

<div style="max-width:560px">
    <div class="admin-form-card" style="border:2px solid #e74c3c">
        <div class="admin-form-header bg-danger text-white" style="border-radius:10px 10px 0 0">
            <h5 class="mb-0 fw-bold"><i class="bi bi-trash me-2"></i>Delete Book</h5>
        </div>
        <div class="admin-form-body">
            <div class="d-flex gap-4 align-items-start mb-4">
                <div class="book-cover @CoverClass(Model.Id) flex-shrink-0"
                     style="width:80px;height:100px;border-radius:10px;font-size:2.2rem">
                    📖
                </div>
                <div>
                    <h5 class="fw-bold mb-1">@Model.Title</h5>
                    <p class="text-muted mb-1">by @Model.Author</p>
                    <p class="mb-1">Price: <strong>$@Model.Price.ToString("0.00")</strong></p>
                    <p class="mb-0">Stock: <strong>@Model.Stock copies</strong></p>
                </div>
            </div>
            <div class="alert alert-danger d-flex gap-2 align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <span>
                    Are you sure you want to <strong>permanently delete</strong> this book?
                    This action <strong>cannot be undone</strong>.
                </span>
            </div>
            <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-danger btn-lg px-5">
                        <i class="bi bi-trash me-2"></i>Yes, Delete
                    </button>
                    <a asp-controller="Home" asp-action="AdminDashboard"
                       class="btn btn-outline-secondary btn-lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
