@* ============================================================
   FILE: Views/Books/Details.cshtml  (Readora themed)
   PURPOSE: Book detail page with:
     - Cover (gradient or image), Title, Author, Release Date,
       Category, Description, Price, Stock
     - "Add to Cart" button + "Buy Now" button (for logged-in users)
     - Recommended Books section below (Amazon-style)
   Admin sees: Edit + Delete buttons instead.
   ============================================================ *@

@model OnlineBookStore.Models.Book
@{
    ViewData["Title"] = Model.Title;
    string CoverClass(int id) => $"book-cover-{(id % 8) + 1}";
    var suggestedBooks = ViewBag.SuggestedBooks as List<OnlineBookStore.Models.Book> ?? new();
    bool isAdmin    = Context.Session.GetString("UserRole") == "Admin";
    bool isLoggedIn = Context.Session.GetInt32("UserId") != null;
}

<div class="container py-5 fade-in">
    <a asp-action="Index" class="btn btn-outline-blue mb-4">
        <i class="bi bi-arrow-left me-1"></i>Back to Books
    </a>

    <div class="card border-0 shadow-lg" style="border-radius:20px;overflow:hidden;
                                                  border:1px solid var(--border)!important">
        <div class="row g-0">

            @* ── LEFT: Cover ──────────────────────────── *@
            <div class="col-md-4">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Title"
                         style="width:100%;height:100%;object-fit:cover;min-height:400px" />
                }
                else
                {
                    <div class="book-detail-cover @CoverClass(Model.Id)">📖</div>
                }
            </div>

            @* ── RIGHT: Details ────────────────────────── *@
            <div class="col-md-8">
                <div class="p-4 p-md-5">

                    @* Category chip *@
                    @if (!string.IsNullOrEmpty(ViewBag.CategoryName as string))
                    {
                        <span class="category-chip mb-3 d-inline-block">
                            <i class="bi bi-tag me-1"></i>@ViewBag.CategoryName
                        </span>
                    }

                    <h1 style="font-family:'Playfair Display',serif;font-size:2rem;
                               font-weight:700;color:var(--blue);letter-spacing:-0.5px;
                               line-height:1.2" class="mb-1">
                        @Model.Title
                    </h1>

                    <p style="font-size:1.05rem;color:var(--text-muted)" class="mb-1">
                        <i class="bi bi-person me-2"></i>by <strong>@Model.Author</strong>
                    </p>

                    @if (Model.ReleaseDate.HasValue)
                    {
                        <p style="font-size:0.88rem;color:var(--text-muted)" class="mb-3">
                            <i class="bi bi-calendar3 me-2"></i>
                            Published: @Model.ReleaseDate.Value.ToString("MMMM dd, yyyy")
                        </p>
                    }

                    <hr style="border-color:var(--border)" class="my-3" />

                    @* Price + stock *@
                    <div class="d-flex align-items-center gap-3 flex-wrap mb-4">
                        <span style="font-size:2.5rem;font-weight:900;color:var(--blue);
                                     font-family:'Playfair Display',serif">
                            $@Model.Price.ToString("0.00")
                        </span>
                        @if (Model.Stock > 0)
                        {
                            <span class="badge bg-success fs-6 px-3 py-2">
                                <i class="bi bi-check-circle me-1"></i>@Model.Stock in stock
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6 px-3 py-2">Out of Stock</span>
                        }
                    </div>

                    @* Description *@
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mb-4">
                            <h6 style="font-size:0.72rem;letter-spacing:1.5px;text-transform:uppercase;
                                       color:var(--text-muted);font-weight:700" class="mb-2">
                                About This Book
                            </h6>
                            <p style="line-height:1.85;color:#4a5568;font-size:0.97rem">
                                @Model.Description
                            </p>
                        </div>
                    }

                    @* Action Buttons *@
                    <div class="d-flex gap-3 flex-wrap align-items-center">

                        @if (!isAdmin)
                        {
                            @if (Model.Stock > 0 && isLoggedIn)
                            {
                                @* Add to Cart *@
                                <form method="post" asp-controller="Cart" asp-action="AddToCart">
                                    <input type="hidden" name="bookId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-primary btn-lg px-4">
                                        <i class="bi bi-bag-plus me-2"></i>Add to Cart
                                    </button>
                                </form>

                                @* Buy Now — direct single-book checkout *@
                                <a asp-controller="Orders" asp-action="Checkout"
                                   asp-route-bookId="@Model.Id"
                                   class="btn btn-gold btn-lg px-4">
                                    <i class="bi bi-zap me-2"></i>Buy Now
                                </a>
                            }
                            else if (!isLoggedIn)
                            {
                                <a asp-controller="Account" asp-action="Login"
                                   class="btn btn-primary btn-lg px-5">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>Login to Buy
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary btn-lg px-5" disabled>
                                    Out of Stock
                                </button>
                            }
                        }

                        @* Admin Edit / Delete *@
                        @if (isAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id"
                               class="btn btn-warning btn-lg">
                                <i class="bi bi-pencil me-1"></i>Edit Book
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id"
                               class="btn btn-outline-danger btn-lg">
                                <i class="bi bi-trash me-1"></i>Delete
                            </a>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── RECOMMENDED BOOKS ──────────────────────────────────────── *@
@if (suggestedBooks.Count > 0)
{
    <section style="background:var(--cream-2);padding:48px 0 60px;margin-top:20px">
        <div class="container">
            <div class="d-flex align-items-end justify-content-between mb-4">
                <div>
                    <div class="section-eyebrow">Readers Also Enjoyed</div>
                    <div class="section-divider"></div>
                    <h2 class="section-title mb-0">Recommended for You</h2>
                    <p class="section-subtitle mb-0">More books in @ViewBag.CategoryName</p>
                </div>
            </div>
            <div class="row g-4">
                @foreach (var sb in suggestedBooks)
                {
                    <div class="col-sm-6 col-md-3">
                        <div class="book-card">
                            <div class="book-cover @($"book-cover-{(sb.Id % 8) + 1}")">📖</div>
                            <div class="book-card-body">
                                <div class="book-title">@sb.Title</div>
                                <div class="book-author">
                                    <i class="bi bi-person me-1"></i>@sb.Author
                                </div>
                                <div class="book-price">$@sb.Price.ToString("0.00")</div>
                            </div>
                            <div class="book-card-footer">
                                <a asp-action="Details" asp-route-id="@sb.Id"
                                   class="btn btn-outline-blue btn-sm w-100">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
