

@model List<OnlineBookStore.Models.Book>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Books";
    var categories = ViewBag.Categories as List<OnlineBookStore.Models.Category> ?? new();
    string CatName(int? catId) => categories.FirstOrDefault(c => c.Id == catId)?.Name ?? "-";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-0">
            All Books
            <span class="badge rounded-pill ms-2"
                  style="background:#1a3c5f;font-size:0.72rem">@Model.Count</span>
        </h5>
        <p class="text-muted mb-0" style="font-size:0.84rem">
            Add, edit or delete books from the catalogue
        </p>
    </div>
    <a asp-controller="Books" asp-action="Create"
       class="btn btn-admin-gold">
        <i class="bi bi-plus-lg me-1"></i>Add New Book
    </a>
</div>

<div class="admin-table-card">
    <div class="table-responsive">
        <table class="table admin-table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Cover</th>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th style="width:130px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No books found.
                            <a asp-controller="Books" asp-action="Create">Add the first one.</a>
                        </td>
                    </tr>
                }
                @foreach (var book in Model)
                {
                    <tr>
                        <td class="text-muted" style="font-size:0.78rem">@book.Id</td>

                        @* Book cover — real image or gradient placeholder *@
                        <td>
                            @if (!string.IsNullOrEmpty(book.ImageUrl))
                            {
                                <img src="@book.ImageUrl" alt="@book.Title"
                                     style="width:36px;height:48px;object-fit:cover;border-radius:4px;
                                            border:1px solid #e2e8f0" />
                            }
                            else
                            {
                                <div style="width:36px;height:48px;border-radius:4px;
                                            background:linear-gradient(135deg,#1a3c5f,#2d6199);
                                            display:flex;align-items:center;justify-content:center;
                                            font-size:1.2rem">
                                    📖
                                </div>
                            }
                        </td>

                        <td>
                            <div class="fw-semibold" style="font-size:0.88rem;max-width:200px;
                                                            white-space:nowrap;overflow:hidden;
                                                            text-overflow:ellipsis">
                                @book.Title
                            </div>
                        </td>
                        <td style="font-size:0.85rem;color:#64748b">@book.Author</td>
                        <td>
                            <span class="badge rounded-pill"
                                  style="background:#f0f0f0;color:#444;font-weight:600;
                                         font-size:0.72rem">
                                @CatName(book.CategoryId)
                            </span>
                        </td>
                        <td class="fw-bold" style="color:#c9a84c">
                            $@book.Price.ToString("0.00")
                        </td>
                        <td>
                            @if (book.Stock > 0)
                            {
                                <span class="badge bg-success">@book.Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">0</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-controller="Books" asp-action="Edit"
                                   asp-route-id="@book.Id"
                                   class="btn btn-warning btn-sm"
                                   style="font-size:0.74rem;padding:4px 9px"
                                   title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-controller="Books" asp-action="Details"
                                   asp-route-id="@book.Id"
                                   class="btn btn-info btn-sm text-white"
                                   style="font-size:0.74rem;padding:4px 9px"
                                   title="View">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-controller="Books" asp-action="Delete"
                                   asp-route-id="@book.Id"
                                   class="btn btn-danger btn-sm"
                                   style="font-size:0.74rem;padding:4px 9px"
                                   title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
