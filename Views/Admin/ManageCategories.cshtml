@* ============================================================
   FILE: Views/Admin/ManageCategories.cshtml
   PURPOSE: Admin-only categories management table.
            Shows all categories with book counts, and
            Add / Edit / Delete buttons.
            Uses _AdminLayout (dark sidebar).
   ============================================================ *@

@model List<OnlineBookStore.Models.Category>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Categories";
    var bookCounts = ViewBag.BookCounts as Dictionary<int, int> ?? new();
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-0">
            All Categories
            <span class="badge rounded-pill ms-2"
                  style="background:#1a3c5f;font-size:0.72rem">@Model.Count</span>
        </h5>
        <p class="text-muted mb-0" style="font-size:0.84rem">
            Manage the category list used for organising books
        </p>
    </div>
    <a asp-controller="Categories" asp-action="Create"
       class="btn btn-admin-gold">
        <i class="bi bi-folder-plus me-1"></i>Add New Category
    </a>
</div>

<div class="admin-table-card">
    <div class="table-responsive">
        <table class="table admin-table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Category Name</th>
                    <th>Books</th>
                    <th style="width:160px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            No categories found.
                            <a asp-controller="Categories" asp-action="Create">Add the first one.</a>
                        </td>
                    </tr>
                }
                @foreach (var cat in Model)
                {
                    var count = bookCounts.GetValueOrDefault(cat.Id, 0);
                    <tr>
                        <td class="text-muted" style="font-size:0.78rem">@cat.Id</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:32px;height:32px;background:#1a3c5f;
                                            border-radius:8px;display:flex;align-items:center;
                                            justify-content:center;font-size:1rem;flex-shrink:0">
                                    📚
                                </div>
                                <span class="fw-semibold">@cat.Name</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge rounded-pill"
                                  style="background:#e8f0f8;color:#1a3c5f;font-weight:700;
                                         font-size:0.78rem;padding:5px 11px">
                                @count book@(count == 1 ? "" : "s")
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a asp-controller="Categories" asp-action="Edit"
                                   asp-route-id="@cat.Id"
                                   class="btn btn-warning btn-sm"
                                   style="font-size:0.78rem;padding:5px 10px">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <form asp-controller="Admin" asp-action="DeleteCategory"
                                      method="post" style="display:inline"
                                      onsubmit="return confirm('Delete category: @cat.Name?')">
                                    <input type="hidden" name="id" value="@cat.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            style="font-size:0.78rem;padding:5px 10px">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
