@* ============================================================
   FILE: Views/Admin/ManageUsers.cshtml
   PURPOSE: Admin user management. Uses _AdminLayout.
   ============================================================ *@

@model List<OnlineBookStore.Models.User>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Users";
    int? currentUserId = Context.Session.GetInt32("UserId");
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-1">
            All Users <span class="badge rounded-pill" style="background:#1a3c5f;font-size:0.75rem">@Model.Count</span>
        </h5>
        <p class="text-muted mb-0" style="font-size:0.85rem">Manage registered accounts</p>
    </div>
</div>

<div class="admin-table-card">
    <div class="table-responsive">
        <table class="table admin-table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No users</td></tr>
                }
                @foreach (var user in Model)
                {
                    bool isSelf = user.Id == currentUserId;
                    <tr>
                        <td class="text-muted" style="font-size:0.78rem">@user.Id</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle fw-bold text-white d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width:34px;height:34px;font-size:0.85rem;
                                            background:@(user.Role == "Admin" ? "#c9a84c" : "#1a3c5f");
                                            color:@(user.Role == "Admin" ? "#000" : "#fff")">
                                    @user.Name.Substring(0,1).ToUpper()
                                </div>
                                <div>
                                    <div class="fw-semibold" style="font-size:0.88rem">
                                        @user.Name
                                        @if (isSelf)
                                        {
                                            <span class="badge bg-secondary ms-1" style="font-size:0.6rem">You</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="text-muted" style="font-size:0.85rem">@user.Email</td>
                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge" style="background:#c9a84c;color:#000;font-size:0.72rem">
                                    <i class="bi bi-shield-check me-1"></i>Admin
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary" style="font-size:0.72rem">User</span>
                            }
                        </td>
                        <td>
                            @if (!isSelf && user.Role != "Admin")
                            {
                                <form asp-controller="Admin" asp-action="DeleteUser"
                                      method="post" style="display:inline"
                                      onsubmit="return confirm('Delete @user.Name?')">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            style="font-size:0.78rem;padding:4px 10px">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
